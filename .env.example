# The provider key matching ORACLE_MODEL / ORACLE_EMBED_MODEL. Gemini is the default and
# has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Any litellm "provider/model" string works.
# ORACLE_MODEL=gemini/gemini-flash-latest
# ORACLE_EMBED_MODEL=gemini/gemini-embedding-001
# ORACLE_EMBED_DIMS=768
# ORACLE_EMBED_RPM=90        # raise to ~1500 on a paid Gemini key; ingest gets ~15x faster

# Optional. When set, every API route except /healthz requires this in X-API-Key.
# ORACLE_API_KEY=

# Optional. Colon-separated directories that may be ingested as local paths.
# Unset means only git URLs are accepted, which is the right default in a container.
# ALLOWED_REPO_ROOTS=/Users/me/code

# Optional ingest tuning.
# ORACLE_MAP_PASS_DELAY=20   # seconds between map-tier passes; 0 on a paid key
# ORACLE_SKIP_MAP=1          # skip the map tier entirely (faster, weaker on architecture)
# ORACLE_MAX_FILES=4000
# ORACLE_MAX_CHUNKS=12000
